<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %> COFFEE</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/layout.css">
</head>
<body>
<%- include('../../partials/icons') %>

<main style="min-height:100vh;display:grid;place-items:center;padding:32px;background:var(--cream-bg);">
  <div class="card" style="width:min(520px,100%);text-align:center;padding:48px 40px;">
    <div style="width:64px;height:64px;margin:0 auto 20px;display:grid;place-items:center;border-radius:50%;background:var(--sand-100);color:var(--brown-600);">
      <svg width="30" height="30" aria-hidden="true"><use href="#i-<%= icon || 'alert' %>"></use></svg>
    </div>

    <p style="color:var(--text-muted);font-size:var(--text-sm);letter-spacing:.16em;text-transform:uppercase;">
      Lỗi <%= statusCode %>
    </p>
    <h1 style="margin-top:8px;font-size:var(--text-2xl);color:var(--brown-700);"><%= title %></h1>
    <p style="margin-top:12px;color:var(--text-muted);"><%= message %></p>

    <% if (typeof stack !== 'undefined' && stack) { %>
      <pre style="margin-top:20px;padding:16px;border-radius:8px;background:var(--sand-50);color:var(--text-muted);font-size:11px;text-align:left;overflow:auto;max-height:220px;"><%= stack %></pre>
    <% } %>

    <div style="display:flex;gap:12px;justify-content:center;margin-top:28px;">
      <a class="btn" href="<%= homePath %>">Về trang chủ</a>
      <a class="btn btn--secondary" href="/dang-nhap">Đăng nhập</a>
    </div>
  </div>
</main>
</body>
</html>
