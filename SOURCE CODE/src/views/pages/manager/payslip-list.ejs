<%- include('../../partials/head') %>

<div class="app-shell">
  <%- include('../../partials/sidebar') %>

  <div class="main">
    <%- include('../../partials/topbar') %>

    <main class="content">
      <nav class="breadcrumb" aria-label="Đường dẫn">
        <a href="<%= basePath %>/trang-chu">Trang chủ</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Quản lý lương</span>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Cập nhật bảng lương</span>
      </nav>

      <section class="data-card">
        <div class="data-card__head">
          <h1 class="data-card__title">Danh sách phiếu lương</h1>
          <% if (period) { %>
            <span class="data-card__note"><%= period.label %></span>
          <% } %>
        </div>

        <% if (isEmpty) { %>
          <div class="empty-state">
            <span class="empty-state__icon"><svg aria-hidden="true"><use href="#i-alert"></use></svg></span>
            <p class="empty-state__title">Chưa có phiếu lương nào!</p>
          </div>
        <% } else { %>
          <div class="table-wrap">
            <table class="table table--rows table--tan">
              <thead>
                <tr>
                  <th scope="col">Nhân viên</th>
                  <th scope="col">Thực nhận tháng</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function (row) { %>
                  <tr class="table__row--link"
                      data-row-href="<%= basePath %>/luong/cap-nhat/<%= row.maPL %>">
                    <td>
                      <a class="row-link u-strong"
                         href="<%= basePath %>/luong/cap-nhat/<%= row.maPL %>"><%= row.hoTen %></a>
                    </td>
                    <td class="u-strong"><%= row.thucNhanLabel %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </div>
</div>

<%- include('../../partials/foot', { pageScripts: ['/js/manager.js'] }) %>
