<%- include('../../partials/head') %>

<div class="app-shell">
  <%- include('../../partials/sidebar') %>

  <div class="main">
    <%- include('../../partials/topbar') %>

    <main class="content">
      <nav class="breadcrumb" aria-label="Đường dẫn">
        <a href="<%= basePath %>/trang-chu">Trang chủ</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Quản lý chấm công</span>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Dữ liệu chấm công</span>
      </nav>

      <form method="get" action="<%= basePath %>/cham-cong/du-lieu">
        <div class="page-head">
          <h1 class="page-head__title page-title">Dữ liệu chấm công</h1>
          <button class="btn" type="submit">
            <svg width="16" height="16" aria-hidden="true"><use href="#i-search"></use></svg>
            Xem
          </button>
        </div>

        <div class="filter-grid">
          <div class="filter-card">
            <span class="filter-label">
              <svg width="20" height="20" aria-hidden="true"><use href="#i-calendar"></use></svg>
              Thời gian
            </span>

            <div class="time-picker" data-time-picker
                 data-label-day="<%= selectedDateLabel %>"
                 data-label-week="<%= selectedWeekLabel %>">
              <button type="button" class="time-picker__control" data-time-toggle
                      aria-expanded="false" aria-haspopup="true">
                <span data-time-label><%= mode === 'tuan' ? selectedWeekLabel : selectedDateLabel %></span>
                <svg class="time-picker__chevron" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
              </button>

              <div class="time-picker__panel" data-time-panel hidden>
                <div class="time-picker__modes" role="group" aria-label="Xem theo">
                  <button type="button" class="time-mode<%= mode === 'ngay' ? ' is-active' : '' %>"
                          data-time-mode="ngay">Ngày</button>
                  <button type="button" class="time-mode<%= mode === 'tuan' ? ' is-active' : '' %>"
                          data-time-mode="tuan">Tuần</button>
                </div>

                <div class="time-picker__body" data-time-body="ngay" <%= mode === 'ngay' ? '' : 'hidden' %>>
                  <div class="time-cal__head">
                    <button type="button" class="time-cal__nav" data-time-month="<%= calendar.prevMonth %>"
                            aria-label="Tháng trước">‹</button>
                    <span class="time-cal__title"><%= calendar.label %></span>
                    <button type="button" class="time-cal__nav" data-time-month="<%= calendar.nextMonth %>"
                            aria-label="Tháng sau">›</button>
                  </div>
                  <div class="time-cal__grid">
                    <% calendar.cells.forEach(function (cell) { %>
                      <% if (!cell) { %>
                        <span class="time-cal__cell is-empty"></span>
                      <% } else { %>
                        <button type="button" class="time-cal__cell<%= cell.isSelected ? ' is-selected' : '' %>"
                                data-time-day="<%= cell.value %>"><%= cell.day %></button>
                      <% } %>
                    <% }); %>
                  </div>
                </div>

                <div class="time-picker__body" data-time-body="tuan" <%= mode === 'tuan' ? '' : 'hidden' %>>
                  <div class="time-cal__head">
                    <button type="button" class="time-cal__nav" data-time-month="<%= calendar.prevMonth %>"
                            aria-label="Tháng trước">‹</button>
                    <span class="time-cal__title"><%= weeks.label %></span>
                    <button type="button" class="time-cal__nav" data-time-month="<%= calendar.nextMonth %>"
                            aria-label="Tháng sau">›</button>
                  </div>
                  <div class="time-weeks">
                    <% weeks.weeks.forEach(function (item) { %>
                      <button type="button" class="time-week<%= item.isSelected ? ' is-selected' : '' %>"
                              data-time-week="<%= item.weekStart %>">
                        Tuần <%= item.index %> (<%= item.label %>)
                      </button>
                    <% }); %>
                  </div>
                </div>
              </div>

              <input type="hidden" name="cheDo" value="<%= mode %>" data-time-mode-input>
              <input type="hidden" name="ngay" value="<%= selectedDate %>" data-time-day-input>
              <input type="hidden" name="tuan" value="<%= selectedWeek %>" data-time-week-input>
            </div>
          </div>

          <div class="filter-card">
            <span class="filter-label">
              <svg width="20" height="20" aria-hidden="true"><use href="#i-users"></use></svg>
              Nhân viên
            </span>
            <select class="filter-input" name="nhanVien" aria-label="Nhân viên">
              <option value="">Tất cả</option>
              <% employees.forEach(function (item) { %>
                <option value="<%= item.maNV %>" <%= item.maNV === maNV ? 'selected' : '' %>>
                  <%= item.hoTen %>
                </option>
              <% }); %>
            </select>
          </div>

          <div class="filter-card">
            <span class="filter-label">Ca làm</span>
            <select class="filter-input" name="ca" aria-label="Ca làm">
              <option value="">Tất cả</option>
              <% shifts.forEach(function (item) { %>
                <option value="<%= item.maCa %>" <%= item.maCa === maCa ? 'selected' : '' %>>
                  <%= item.label %>
                </option>
              <% }); %>
            </select>
          </div>
        </div>
      </form>

      <% if (summary) { %>
        <div class="summary-cards">
          <div class="summary-card">
            <p class="summary-card__value"><%= fmt.formatHours(summary.tongGio) %>h</p>
            <p class="summary-card__label">Tổng số giờ làm</p>
          </div>
          <div class="summary-card">
            <p class="summary-card__value"><%= summary.soCaTre %></p>
            <p class="summary-card__label">Tổng số ca đi trễ</p>
          </div>
          <div class="summary-card">
            <p class="summary-card__value"><%= summary.soCaBo %></p>
            <p class="summary-card__label">Tổng số ca bỏ</p>
          </div>
        </div>

        <div class="person-card">
          <p class="person-card__name">
            <span class="u-strong">Nhân viên:</span>
            <span><%= selectedEmployee.hoTen %></span>
          </p>

          <% if (isEmpty) { %>
            <p class="u-text-muted"><%= emptyMessage %></p>
          <% } else { %>
            <div class="table-wrap">
              <table class="table table--compact">
                <thead>
                  <tr>
                    <th scope="col">Ngày</th>
                    <th scope="col">Giờ vào</th>
                    <th scope="col">Giờ ra</th>
                  </tr>
                </thead>
                <tbody>
                  <% rows.forEach(function (row) { %>
                    <tr>
                      <td class="u-nowrap"><%= row.ngay %></td>
                      <td class="u-strong"><%= row.gioVaoLabel %></td>
                      <td class="u-strong"><%= row.gioRaLabel %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      <% } else if (isEmpty) { %>
        <div class="empty-state">
          <span class="empty-state__icon"><svg aria-hidden="true"><use href="#i-alert"></use></svg></span>
          <p class="empty-state__title"><%= emptyMessage %></p>
        </div>
      <% } else { %>
        <div class="data-card data-card--table">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Thời gian</th>
                  <th scope="col">Nhân viên</th>
                  <th scope="col">Ca làm</th>
                  <th scope="col">Giờ vào</th>
                  <th scope="col">Giờ ra</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function (row) { %>
                  <tr>
                    <td class="u-nowrap"><%= row.ngay %></td>
                    <td><%= row.hoTen %></td>
                    <td class="u-strong"><%= row.tenCa %></td>
                    <td><%= row.gioVaoLabel %></td>
                    <td><%= row.gioRaLabel %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</div>

<%- include('../../partials/foot', { pageScripts: ['/js/manager.js'] }) %>
