<%- include('../../partials/head') %>

<div class="app-shell">
  <%- include('../../partials/sidebar') %>

  <div class="main">
    <%- include('../../partials/topbar') %>

    <main class="content">
      <nav class="breadcrumb" aria-label="Đường dẫn">
        <a href="<%= basePath %>/trang-chu">Trang chủ</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Xem danh sách ca làm</span>
      </nav>

      <div class="page-head">
        <h1 class="page-head__title">Danh sách ca làm</h1>
      </div>

      <form class="filter-bar" method="get" action="<%= basePath %>/ca-lam/danh-sach">
        <div class="filter-field">
          <span class="filter-label">Xem theo</span>
          <div class="segmented" role="group" aria-label="Xem theo">
            <label class="segmented__item">
              <input class="u-sr-only" type="radio" name="cheDo" value="ngay"
                     <%= mode === 'ngay' ? 'checked' : '' %> data-auto-submit>
              <span>Ngày</span>
            </label>
            <label class="segmented__item">
              <input class="u-sr-only" type="radio" name="cheDo" value="tuan"
                     <%= mode === 'tuan' ? 'checked' : '' %> data-auto-submit>
              <span>Tuần</span>
            </label>
          </div>
        </div>

        <div class="filter-field">
          <label class="filter-label" for="timeFilter"><%= mode === 'ngay' ? 'Ngày làm việc' : 'Tuần làm việc' %></label>
          <% if (mode === 'ngay') { %>
            <input class="filter-input" type="date" id="timeFilter" name="ngay" value="<%= selectedDate %>">
          <% } else { %>
            <select class="filter-input" id="timeFilter" name="tuan">
              <% weekOptions.forEach(function (item) { %>
                <option value="<%= item.weekStart %>" <%= item.isSelected ? 'selected' : '' %>>
                  <%= item.label %><%= item.isCurrent ? ' (tuần này)' : '' %>
                </option>
              <% }); %>
            </select>
          <% } %>
        </div>

        <div class="filter-field">
          <label class="filter-label" for="shiftFilter">Ca làm</label>
          <select class="filter-input" id="shiftFilter" name="ca">
            <option value="">Tất cả ca làm</option>
            <% shifts.forEach(function (item) { %>
              <option value="<%= item.maCa %>" <%= item.isSelected ? 'selected' : '' %>>
                <%= item.tenCa %>
              </option>
            <% }); %>
          </select>
        </div>

        <div class="filter-field filter-field--action">
          <button class="btn" type="submit">
            <svg width="16" height="16" aria-hidden="true"><use href="#i-search"></use></svg>
            Xem
          </button>
        </div>
      </form>

      <% if (isEmpty) { %>
        <div class="empty-state">
          <span class="empty-state__icon"><svg aria-hidden="true"><use href="#i-alert"></use></svg></span>
          <p class="empty-state__title"><%= emptyMessage %></p>
        </div>
      <% } else { %>
        <% days.forEach(function (day) { %>
          <section class="schedule-day">
            <h2 class="schedule-day__title">Lịch làm việc · <%= day.ngayLabel %></h2>

            <div class="data-card data-card--table">
              <div class="table-wrap">
                <table class="table table--plain">
                  <thead>
                    <tr>
                      <th scope="col">Ngày</th>
                      <th scope="col">Ca làm</th>
                      <th scope="col">Giờ</th>
                      <th scope="col">Nhân viên được xếp</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% day.rows.forEach(function (row, index) { %>
                      <tr>
                        <td class="u-nowrap"><%= index === 0 ? day.ngayLabel : '' %></td>
                        <td class="u-strong"><%= row.tenCa %></td>
                        <td class="u-nowrap"><%= row.khungGio %></td>
                        <td class="u-strong"><%= row.tenNhanVien %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          </section>
        <% }); %>
      <% } %>
    </main>
  </div>
</div>

<%- include('../../partials/foot') %>
