<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#A1745F">
  <title>Đăng nhập · <%= appName %> COFFEE</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/layout.css">
</head>
<body>
<%- include('../../partials/icons') %>

<main class="auth-page">
  <!-- ---------------------------------------------------------------- -->
  <!-- Cột trái: thương hiệu + minh hoạ (như ảnh doc/UI/Đăng nhập)       -->
  <!-- ---------------------------------------------------------------- -->
  <aside class="auth-aside">
    <p class="auth-brand">
      <svg aria-hidden="true"><use href="#i-cup"></use></svg>
      <span>NICK <em>&amp;</em> THE JUICE</span>
    </p>

    <div class="auth-art" aria-hidden="true">
      <svg viewBox="0 0 360 440" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- vòm be -->
        <path d="M30 404V249a150 150 0 0 1 300 0v155z" fill="#e9d6c4"/>
        <!-- mặt bàn -->
        <path d="M0 404h360" stroke="rgba(84,43,20,.32)" stroke-width="1.4"/>
        <!-- hơi nước -->
        <g stroke="#f8efe4" stroke-width="5" stroke-linecap="round" opacity=".95">
          <path d="M146 226l-17-38"/>
          <path d="M180 214l-17-46"/>
          <path d="M212 230l-15-34"/>
        </g>
        <!-- tách -->
        <path d="M92 258h176v40a55 55 0 0 1-55 55h-66a55 55 0 0 1-55-55z" fill="#fbf3ea"/>
        <path d="M268 274h12a26 26 0 0 1 0 52h-12" stroke="#fbf3ea" stroke-width="10" stroke-linecap="round"/>
        <!-- bóng đổ -->
        <ellipse cx="180" cy="372" rx="96" ry="9" fill="rgba(84,43,20,.26)"/>
      </svg>
    </div>

    <div class="auth-beans" aria-hidden="true">
      <svg class="bean"><use href="#i-bean-fill"></use></svg>
      <svg class="bean bean--sm"><use href="#i-bean-fill"></use></svg>
    </div>
  </aside>

  <!-- ---------------------------------------------------------------- -->
  <!-- Cột phải: biểu mẫu đăng nhập                                      -->
  <!-- ---------------------------------------------------------------- -->
  <section class="auth-main">
    <div class="auth-card">
      <div class="auth-ornament" aria-hidden="true">
        <svg class="bean"><use href="#i-bean-fill"></use></svg>
        <svg class="bean bean--sm"><use href="#i-bean-fill"></use></svg>
      </div>

      <h1 class="auth-heading">
        <span class="auth-heading__hello">Chào mừng đến với</span>
        <span class="auth-heading__brand">Nick &amp; Juice Coffee</span>
      </h1>

      <p class="auth-card__subtitle">Đăng nhập để bắt đầu công việc tại quán...</p>

      <form class="auth-form" method="post" action="/dang-nhap" novalidate data-validate-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="auth-field">
          <svg class="auth-field__icon" aria-hidden="true"><use href="#i-user"></use></svg>
          <label class="u-sr-only" for="phone">Tên đăng nhập</label>
          <input class="auth-input <%= fieldErrors.phone ? 'is-invalid' : '' %>"
                 type="tel"
                 id="phone"
                 name="phone"
                 value="<%= form.phone || '' %>"
                 placeholder="Tên đăng nhập"
                 autocomplete="username"
                 inputmode="numeric"
                 maxlength="10"
                 data-required="Không được để trống Tên đăng nhập và mật khẩu !">
        </div>

        <div class="auth-field password-field">
          <svg class="auth-field__icon" aria-hidden="true"><use href="#i-lock"></use></svg>
          <label class="u-sr-only" for="password">Mật khẩu</label>
          <input class="auth-input <%= fieldErrors.password ? 'is-invalid' : '' %>"
                 type="password"
                 id="password"
                 name="password"
                 placeholder="Mật khẩu"
                 autocomplete="current-password"
                 data-required="Không được để trống Tên đăng nhập và mật khẩu !">
          <button type="button" class="password-field__toggle" data-toggle-password aria-label="Hiện mật khẩu">
            <svg aria-hidden="true"><use href="#i-eye-off"></use></svg>
          </button>
        </div>

        <% if (error) { %>
          <p class="auth-error" role="alert"><%= error %></p>
        <% } %>

        <button type="submit" class="auth-submit">Đăng nhập</button>
      </form>

      <div class="auth-meta" aria-hidden="true">
        <svg class="bean bean--sm"><use href="#i-bean-fill"></use></svg>
      </div>
      <p class="auth-address">311 Hồ Nghinh, Sơn Trà, Đà Nẵng</p>

      <% if (demoAccounts && demoAccounts.length) { %>
        <div class="auth-demo">
          <p class="auth-demo__title">Tài khoản demo — mật khẩu 123456</p>
          <% demoAccounts.forEach(function (acc) { %>
            <div class="auth-demo__row">
              <span><%= acc.role %></span>
              <strong><%= acc.phone %></strong>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </section>
</main>

<script src="/js/app.js" defer></script>
</body>
</html>
