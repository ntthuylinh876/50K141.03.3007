<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kết nối sai Wifi · <%= appName %> COFFEE</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/layout.css">
</head>
<body>
<%- include('../../partials/icons') %>

<main style="min-height:100vh;display:grid;place-items:center;padding:32px;background:var(--cream-bg);">
  <div class="card" style="width:min(500px,100%);text-align:center;padding:48px 40px;">
    <div style="width:72px;height:72px;margin:0 auto 22px;display:grid;place-items:center;border-radius:50%;background:var(--red-soft);color:var(--red);">
      <svg width="34" height="34" aria-hidden="true"><use href="#i-wifi-off"></use></svg>
    </div>

    <h1 style="font-size:var(--text-2xl);color:var(--brown-700);">Kết nối sai Wifi</h1>
    <p style="margin-top:12px;color:var(--text-muted);line-height:1.7;">
      Bạn cần kết nối vào mạng Wi-Fi của quán để chấm công.<br>
      Vui lòng kiểm tra lại kết nối rồi thử lại.
    </p>

    <div style="display:flex;gap:12px;justify-content:center;margin-top:28px;">
      <a class="btn" href="<%= homePath %>">Thử lại</a>
    </div>
  </div>
</main>
</body>
</html>
