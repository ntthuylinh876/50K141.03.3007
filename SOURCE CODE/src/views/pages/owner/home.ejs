<%- include('../../partials/head') %>

<div class="app-shell">
  <%- include('../../partials/sidebar') %>

  <div class="main">
    <%- include('../../partials/topbar') %>

    <main class="content">
      <% if (notice) { %>
        <%- include('../../partials/notice-modal', { type: 'error', message: notice }) %>
      <% } %>

      <section class="home-welcome">
        <h1 class="page-head__title home-welcome__title page-title">Chào mừng bạn đã quay trở lại !</h1>
      </section>

      <div class="home-cards">
        <a class="home-card" href="<%= basePath %>/ca-lam/cap-nhat">
          <span class="home-card__icon">
            <svg aria-hidden="true"><use href="#i-cup"></use></svg>
          </span>
          <span class="home-card__label">Cập nhật<br>ca làm</span>
        </a>

        <a class="home-card" href="<%= basePath %>/ca-lam/danh-sach">
          <span class="home-card__icon">
            <svg aria-hidden="true"><use href="#i-cup"></use></svg>
          </span>
          <span class="home-card__label">Xem danh<br>sách ca làm</span>
        </a>
      </div>
    </main>
  </div>
</div>

<%- include('../../partials/foot') %>
