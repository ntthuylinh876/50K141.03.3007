<%- include('../../partials/head') %>

<div class="app-shell">
  <%- include('../../partials/sidebar') %>

  <div class="main">
    <%- include('../../partials/topbar') %>

    <main class="content">
      <nav class="breadcrumb" aria-label="Đường dẫn">
        <a href="<%= basePath %>/trang-chu">Trang chủ</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">Cập nhật ca làm</span>
      </nav>

      <div class="page-head">
        <h1 class="page-head__title">Cập nhật ca làm</h1>
      </div>

      <form class="select-pill" method="get" action="<%= basePath %>/ca-lam/cap-nhat">
        <svg class="select-pill__icon" aria-hidden="true"><use href="#i-calendar"></use></svg>
        <label class="sr-only" for="weekSelect">Tuần làm việc</label>
        <select class="select-pill__select" id="weekSelect" name="tuan" data-auto-submit>
          <% weekOptions.forEach(function (item) { %>
            <option value="<%= item.weekStart %>" <%= item.isSelected ? 'selected' : '' %>>
              <%= item.label %><%= item.isCurrent ? ' (tuần này)' : '' %>
            </option>
          <% }); %>
        </select>
        <svg class="select-pill__chevron" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
      </form>

      <% if (isEmpty) { %>
        <div class="empty-state">
          <span class="empty-state__icon"><svg aria-hidden="true"><use href="#i-alert"></use></svg></span>
          <p class="empty-state__title">Chưa có lịch làm việc cho thời gian này!</p>
        </div>
      <% } else { %>
        <div class="data-card data-card--table">
          <div class="table-wrap">
            <table class="table table--plain">
              <thead>
                <tr>
                  <th scope="col">Ngày làm</th>
                  <th scope="col">Ca</th>
                  <th scope="col">Khung giờ</th>
                  <th scope="col">Nhân viên</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function (row) { %>
                  <tr class="table__row--link" data-row-href="<%= basePath %>/ca-lam/cap-nhat/<%= row.maCa %>/<%= row.ngayISO %>">
                    <td>
                      <a class="row-link" href="<%= basePath %>/ca-lam/cap-nhat/<%= row.maCa %>/<%= row.ngayISO %>">
                        <%= row.ngayLabel %>
                      </a>
                    </td>
                    <td><%= row.tenCa %></td>
                    <td class="u-nowrap"><%= row.khungGio %></td>
                    <td><%= row.tenNhanVien %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</div>

<%- include('../../partials/foot', { pageScripts: ['/js/manager.js'] }) %>
